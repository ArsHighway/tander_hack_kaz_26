# Скопировать в .env и поменять пароли. Все переменные необязательные: без .env работают значения по умолчанию.

POSTGRES_USER=tenderhack
POSTGRES_PASSWORD=tenderhack
POSTGRES_DB=tenderhack
RABBITMQ_USER=tenderhack
RABBITMQ_PASSWORD=tenderhack

# Порты на хосте
POSTGRES_PORT=5432
REDIS_PORT=6379
RABBITMQ_PORT=5672
RABBITMQ_UI_PORT=15672
LLM_PORT=8081
EMBED_PORT=8082
API_PORT=8000
WEB_PORT=8080

# Модель — локальная gemma-4-31b-it-Q8_0.gguf в llama.cpp server (сервис `llm` в docker-compose.yml,
# профиль llm). Файлы .gguf кладутся в ./models (models/README.md); запуск —
# `docker compose --profile llm up -d`. Внешних облачных API нет, данные организаторов с машины не уходят.
# Проверка модели и сервера — `python -m app.tools.llm_smoke`.
#
# Протокол — OpenAI-совместимый API llama.cpp server (`openai` — единственное значение). Адрес не
# задаём: контейнеры ходят на http://llm:8080/v1 (значение по умолчанию в docker-compose.yml), утилиты
# с хоста — на http://127.0.0.1:8081/v1 (порт LLM_PORT). Другой сервер с тем же API — LLM_BASE_URL.
LLM_PROVIDER=openai
#LLM_BASE_URL=http://llm:8080/v1
LLM_API_KEY=
# Имя модели в API — `--alias` сервера; файл в ./models — LLM_MODEL_FILE.
LLM_CHAT_MODEL=gemma-4-31b-it-Q8_0
LLM_MODEL_FILE=gemma-4-31b-it-Q8_0.gguf
# Второй слой модели (перепроверка неподтверждённых значений) — та же модель на том же сервере.
LLM_REVIEW_MODEL=gemma-4-31b-it-Q8_0
# Контекст llama.cpp на все параллельные слоты (на запрос — LLM_CTX / LLM_PARALLEL) и слоты.
LLM_CTX=16384
LLM_PARALLEL=4
# Рассуждения: false — выключить; low / medium / high — для моделей, которые не выключают их совсем
# (gpt-oss). Для gemma — false.
LLM_THINK=false
LLM_REQUIRED=false
# Модель при старте включена; дальше её включает и выключает модератор (страница «Модерация»).
LLM_ENABLED=true
# Модель ставит первым самый вероятный тип в вопросе «какой это товар»: на эталоне hard.csv верный
# тип первым 53 % → 74 % (docs/qa/2026-10-11-hard-gold.md).
LLM_RERANK_TYPES=true

# Эмбеддинги — bge-m3.gguf в отдельном llama.cpp server (сервис `embed`, 1024 измерения, как в индексе
# pgvector). Адрес по умолчанию — http://embed:8080/v1 в контейнерах и http://127.0.0.1:8082/v1 с хоста.
EMBED_PROVIDER=openai
#EMBED_BASE_URL=http://embed:8080/v1
EMBED_API_KEY=
EMBED_MODEL=bge-m3
EMBED_MODEL_FILE=bge-m3-Q8_0.gguf

# Справочник позиций: файлы через запятую (.json или .csv). Пусто — демо-справочник из репозитория
# (backend/app/catalog/demo/demo.json). Справочник организаторов: data/<файл> (в docker это /app/data/<файл>).
# Первый этап — тип товара по КТРУ: data/catalog/ktru_types.json (`build_ktru_types`); категории
# портала — data/catalog/standards.json. После смены — `index_catalog` (векторы этого справочника).
CATALOG_PATHS=
# Похожие СТЕ для поиска категории (python -m app.tools.build_exemplars): со справочником
# стандартов — CATALOG_PATHS=data/catalog/standards.json, EXEMPLARS_PATH=data/catalog/exemplars.jsonl.
# Пусто — категория только по тексту позиций справочника. Подсказки полей по похожим СТЕ —
# exemplars.values.sqlite рядом (python -m app.tools.build_exemplar_values <exemplars.jsonl>).
# С синтетикой редких категорий (python -m app.tools.synthetic_exemplars merge) —
# EXEMPLARS_PATH=data/catalog/exemplars_syn.jsonl; файл характеристик тогда exemplars_syn.values.sqlite
# (та же база, что у exemplars.jsonl: у синтетики характеристик нет).
EXEMPLARS_PATH=
# Векторы тех же наименований (python -m app.tools.build_exemplar_vectors, ~10 мин на bge-m3): второй
# голос категорий к BM25, например EXEMPLAR_VECTORS_PATH=data/catalog/exemplars_syn.vectors.npz.
# Пусто — голосует только BM25.
EXEMPLAR_VECTORS_PATH=
# Двойники: такая СТЕ уже есть на портале (python -m app.tools.build_twins, ~8 мин, ~4 ГБ), например
# TWINS_PATH=data/catalog/twins.sqlite. Категория и значения полей из СТЕ с тем же наименованием или
# моделью, замечание «заявку-дубль отклонят». Пусто — без них.
TWINS_PATH=
# Справочник КТРУ (python -m app.tools.fetch_ktru, затем build_ktru_catalog): второй этап — позиция
# КТРУ внутри найденной категории, например KTRU_PATHS=data/catalog/ktru.json; из выгрузки XML ЕИС
# организаторов — build_ktru_catalog --xml <zip> → KTRU_PATHS=data/catalog/ktru_xml.json. Пусто — без него.
KTRU_PATHS=
# Кэш картинок портала (фото похожих СТЕ, картинки категорий): прокси /api/v1/images/*. Прогрев для демо —
# `uv run python -m app.tools.warm_images --texts ../docs/demo-texts.txt` из backend/.
IMAGE_CACHE_DIR=data/cache/images
# Браузер ждёт портал не дольше IMAGE_WAIT_S, дальше картинка докачивается в фоне (до IMAGE_TIMEOUT_S) к следующему показу.
IMAGE_WAIT_S=1.0
IMAGE_TIMEOUT_S=30.0
# Порог «товар вне справочника» (0..1) — калибруется: python -m app.tools.evaluate
SEARCH_MIN_SCORE=0.2
# Куда evaluate пишет метрики; их отдаёт GET /api/v1/metrics
METRICS_PATH=data/metrics/latest.json
# Куда portal_report пишет отчёт по живым карточкам портала; его отдаёт GET /api/v1/metrics/portal
PORTAL_REPORT_PATH=data/metrics/portal.json
# Отчёт evaluate_holdout (отложенная выборка СТЕ); его отдаёт GET /api/v1/metrics/holdout
HOLDOUT_REPORT_PATH=data/metrics/holdout.json
# Кэш ответов модели в Redis, секунды (0 — выключить, например при сравнении моделей). Семь суток:
# прогрев перед показом (app.tools.warm_llm) должен дожить до защиты; другой промпт — другой ключ.
LLM_CACHE_TTL_S=604800

# Масштабирование (замеры и как считать — docs/scaling.md)
# 429 от сервера модели (перегрузка): повторов с паузой Retry-After или 1, 2, 4 … 30 с.
# Исчерпаны — строка идёт только по правилам (degraded «llm»), а не падает.
LLM_RATE_LIMIT_RETRIES=6
# Сколько ждать модель в шаге мастера и строке пакета, с: не успела — карточка без неё
# (описание целиком — до минуты), пусто — без предела. Модель спрашивают только о позиции с определённым
# кодом; на паузу (2 мин) она уходит только от отказа сервиса, не от плохого входа (400, NaN).
LLM_BUDGET_S=15
# Одновременных запросов к чат-модели на процесс; всего к модели — (1 API + WORKER_REPLICAS) × это число.
LLM_MAX_CONCURRENCY=4
# Реплик воркера (на ходу: docker compose up -d --scale worker=N). Порции одного файла разбирают все.
WORKER_REPLICAS=2
# Процессов API (uvicorn --workers): каждый держит справочник и индексы в памяти, ~2,5 ГБ.
API_WORKERS=1
# Строк в одной порции очереди jobs.batch и строк одновременно в одном воркере.
BATCH_CHUNK_ROWS=20
# Срок ожидания и обработки пакета, секунды.
BATCH_PENDING_TTL_S=86400
# Сколько хранится готовый пакет («Мои заявки → Пакеты»), по умолчанию неделя.
BATCH_TTL_S=604800
JOB_TTL_S=3600
# Таймаут ответа Redis при нагрузке на API и воркеры, секунды.
REDIS_SOCKET_TIMEOUT_S=30
WORKER_CONCURRENCY=4

LOG_LEVEL=INFO
